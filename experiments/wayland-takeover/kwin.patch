--- /dev/null
+++ b/src/plugins/eis/localtakeovertest.cpp
@@ -0,0 +1,212 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "backends/libinput/connection.h"
+#include "backends/libinput/context.h"
+#include "backends/libinput/device.h"
+#include "backends/libinput/localtakeover.h"
+#include "core/inputdevice.h"
+#include "core/session.h"
+#include "eisbackend.h"
+#include "eiscontext.h"
+#include "mock_libinput.h"
+
+#include <QDBusConnection>
+#include <QTest>
+
+#include <libei.h>
+#include <linux/input-event-codes.h>
+
+namespace KWin
+{
+
+class Sender
+{
+public:
+    explicit Sender(int fd)
+    {
+        ei_configure_name(m_ei.get(), "local takeover contract");
+        connected = ei_setup_backend_fd(m_ei.get(), fd) == 0;
+    }
+
+    void dispatch()
+    {
+        ei_dispatch(m_ei.get());
+        while (auto event = ei_get_event(m_ei.get())) {
+            switch (ei_event_get_type(event)) {
+            case EI_EVENT_SEAT_ADDED:
+                ei_seat_bind_capabilities(ei_event_get_seat(event), EI_DEVICE_CAP_POINTER, EI_DEVICE_CAP_BUTTON, nullptr);
+                break;
+            case EI_EVENT_DEVICE_RESUMED:
+                pointer.reset(ei_device_ref(ei_event_get_device(event)));
+                ei_device_start_emulating(pointer.get(), 1);
+                break;
+            case EI_EVENT_DISCONNECT:
+                disconnected = true;
+                break;
+            default:
+                break;
+            }
+            ei_event_unref(event);
+        }
+    }
+
+    void move()
+    {
+        ei_device_pointer_motion(pointer.get(), 1, 0);
+        ei_device_frame(pointer.get(), ei_now(m_ei.get()));
+    }
+
+    void holdButton()
+    {
+        ei_device_button_button(pointer.get(), BTN_LEFT, true);
+        ei_device_frame(pointer.get(), ei_now(m_ei.get()));
+    }
+
+private:
+    std::unique_ptr<ei, decltype(&ei_unref)> m_ei{ei_new_sender(nullptr), ei_unref};
+
+public:
+    std::unique_ptr<ei_device, decltype(&ei_device_unref)> pointer{nullptr, ei_device_unref};
+    bool connected = false;
+    bool disconnected = false;
+};
+
+class EisLocalTakeoverTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void queuedInputStops_data()
+    {
+        QTest::addColumn<int>("eventType");
+        QTest::addColumn<bool>("pressed");
+        QTest::newRow("mouse motion") << int(LIBINPUT_EVENT_POINTER_MOTION) << false;
+        QTest::newRow("key press") << int(LIBINPUT_EVENT_KEYBOARD_KEY) << true;
+        QTest::newRow("button press") << int(LIBINPUT_EVENT_POINTER_BUTTON) << true;
+    }
+
+    void queuedInputStops()
+    {
+        QFETCH(int, eventType);
+        QFETCH(bool, pressed);
+        const auto type = static_cast<libinput_event_type>(eventType);
+        QVERIFY(!LibInput::isLocalTakeoverEvent(LIBINPUT_EVENT_KEYBOARD_KEY, false));
+        QVERIFY(!LibInput::isLocalTakeoverEvent(LIBINPUT_EVENT_POINTER_BUTTON, false));
+
+        const auto service = QDBusConnection::sessionBus().baseService();
+        QVERIFY(!service.isEmpty());
+        m_interruptedCookie = 0;
+        QVERIFY(QDBusConnection::sessionBus().connect(service,
+            QStringLiteral("/org/kde/KWin/EIS/RemoteDesktop"),
+            QStringLiteral("org.kde.KWin.EIS.RemoteDesktop"),
+            QStringLiteral("LocalTakeover"), this, SLOT(recordLocalTakeover(int))));
+        int motions = 0;
+        int holds = 0;
+        int releases = 0;
+        EisBackend backend;
+        auto seat = Session::create(Session::Type::Noop);
+        QVERIFY(seat);
+        std::unique_ptr<LibInput::Connection> nativeConnection(LibInput::Connection::create(seat.get()));
+        QVERIFY(nativeConnection);
+        connect(nativeConnection.get(), &LibInput::Connection::physicalInput, &backend, &EisBackend::stopOnLocalInput);
+        libinput_device fakeDevice;
+        fakeDevice.keyboard = true;
+        fakeDevice.pointer = true;
+        LibInput::Device nativeDevice(&fakeDevice);
+        int forwardedLocalEvents = 0;
+        const auto onLocalEvent = [&] {
+            QCOMPARE(releases, 1);
+            ++forwardedLocalEvents;
+        };
+        connect(&nativeDevice, &InputDevice::pointerMotion, this, onLocalEvent);
+        connect(&nativeDevice, &InputDevice::keyChanged, this, onLocalEvent);
+        connect(&nativeDevice, &InputDevice::pointerButtonChanged, this, onLocalEvent);
+
+        connect(&backend, &InputBackend::deviceAdded, this, [&](InputDevice *device) {
+            connect(device, &InputDevice::pointerMotion, device, [&] {
+                ++motions;
+            });
+            connect(device, &InputDevice::pointerButtonChanged, device, [&](uint32_t, PointerButtonState state) {
+                if (state == PointerButtonState::Pressed) {
+                    ++holds;
+                } else {
+                    ++releases;
+                }
+            });
+        });
+
+        const auto capabilities = QFlags{EIS_DEVICE_CAP_POINTER} | EIS_DEVICE_CAP_BUTTON;
+        auto optedIn = std::make_unique<EisContext>(&backend, capabilities, 1, service, true);
+        auto ordinary = std::make_unique<EisContext>(&backend, capabilities, 2, service, false);
+        Sender sender(optedIn->addClient());
+        Sender ordinarySender(ordinary->addClient());
+        backend.m_contexts.push_back(std::move(optedIn));
+        backend.m_contexts.push_back(std::move(ordinary));
+        QVERIFY(sender.connected);
+        QVERIFY(ordinarySender.connected);
+        QTRY_VERIFY((sender.dispatch(), bool(sender.pointer)));
+        QTRY_VERIFY((ordinarySender.dispatch(), bool(ordinarySender.pointer)));
+
+        sender.move();
+        sender.holdButton();
+        QTRY_COMPARE(motions, 1);
+        QTRY_COMPARE(holds, 1);
+
+        sender.move();
+        QVERIFY(LibInput::isLocalTakeoverEvent(type, pressed));
+        // The EIS request is already queued. Deliver a native libinput event
+        // through the production dispatcher before running the Qt EIS notifier.
+        auto input = static_cast<libinput *>(*nativeConnection->m_input);
+        input->queuedEvents.push(makeLocalEvent(type, &fakeDevice));
+        nativeConnection->handleEvent();
+        nativeConnection->processEvents();
+        QCOMPARE(releases, 1);
+        QCOMPARE(forwardedLocalEvents, 1);
+
+        ordinarySender.move();
+        QTRY_VERIFY((sender.dispatch(), sender.disconnected));
+        QTRY_COMPARE(m_interruptedCookie, 1);
+        QTRY_COMPARE(motions, 2);
+        QCOMPARE(releases, 1);
+        QCOMPARE(backend.m_contexts.size(), 1);
+        QCOMPARE(backend.m_contexts.front()->cookie, 2);
+        QVERIFY(!ordinarySender.disconnected);
+        QVERIFY(QDBusConnection::sessionBus().disconnect(service,
+            QStringLiteral("/org/kde/KWin/EIS/RemoteDesktop"),
+            QStringLiteral("org.kde.KWin.EIS.RemoteDesktop"),
+            QStringLiteral("LocalTakeover"), this, SLOT(recordLocalTakeover(int))));
+    }
+
+    void recordLocalTakeover(int cookie)
+    {
+        m_interruptedCookie = cookie;
+    }
+
+private:
+    int m_interruptedCookie = 0;
+
+    static std::unique_ptr<libinput_event> makeLocalEvent(libinput_event_type type, libinput_device *device)
+    {
+        if (type == LIBINPUT_EVENT_KEYBOARD_KEY) {
+            auto event = std::make_unique<libinput_event_keyboard>();
+            event->device = device;
+            event->state = LIBINPUT_KEY_STATE_PRESSED;
+            event->key = KEY_A;
+            return event;
+        }
+        auto event = std::make_unique<libinput_event_pointer>();
+        event->type = type;
+        event->device = device;
+        event->delta = QPointF(3, 0);
+        event->buttonState = LIBINPUT_BUTTON_STATE_PRESSED;
+        event->button = BTN_LEFT;
+        return event;
+    }
+};
+
+} // namespace KWin
+
+QTEST_GUILESS_MAIN(KWin::EisLocalTakeoverTest)
+#include "localtakeovertest.moc"
