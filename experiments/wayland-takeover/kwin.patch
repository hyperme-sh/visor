+void EisBackend::stopOnLocalInput()
+{
+    std::vector<int> stopped;
+    for (const auto &context : m_contexts) {
+        if (context->stopOnLocalInput()) {
+            stopped.push_back(context->cookie);
+        }
+    }
+
+    const auto findContext = [this](int cookie) {
+        return std::ranges::find(m_contexts, cookie, &EisContext::cookie);
+    };
+    for (const int cookie : stopped) {
+        const auto context = findContext(cookie);
+        if (context != m_contexts.end()) {
+            (*context)->releaseHeldInputs();
+        }
+    }
+    if (!stopped.empty()) {
+        // Keep any currently executing EIS callback alive until it unwinds.
+        QMetaObject::invokeMethod(this, [this, stopped = std::move(stopped), findContext] {
+            const auto bus = QDBusConnection::sessionBus();
+            for (const int cookie : stopped) {
+                const auto context = findContext(cookie);
+                if (context == m_contexts.end()) {
+                    continue;
+                }
+                auto notification = QDBusMessage::createTargetedSignal(
+                    (*context)->dbusService,
+                    QStringLiteral("/org/kde/KWin/EIS/RemoteDesktop"),
+                    QStringLiteral("org.kde.KWin.EIS.RemoteDesktop"),
+                    QStringLiteral("LocalTakeover"));
+                notification << cookie;
+                m_contexts.erase(context);
+                bus.send(notification);
+            }
+        }, Qt::QueuedConnection);
+    }
