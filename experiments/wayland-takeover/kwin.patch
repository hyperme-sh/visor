+/*
+    SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+namespace KWin
+{
+
+class LocalTakeoverGate
+{
+public:
+    explicit LocalTakeoverGate(bool enabled)
+        : m_enabled(enabled)
+    {
+    }
+
+    bool stop()
+    {
+        if (!m_enabled || m_stopped) {
+            return false;
+        }
+        m_stopped = true;
+        return true;
+    }
+
+    bool stopped() const
+    {
+        return m_stopped;
+    }
+
+private:
+    const bool m_enabled;
+    bool m_stopped = false;
+};
+
+} // namespace KWin
