+    if (localTakeover) {
+        const auto owner = bus.interface()->serviceOwner(QStringLiteral("org.freedesktop.portal.Desktop"));
+        if (!owner.isValid() || owner.value() != message.service() || session->appId() != appId || !session->hasFreshLocalConsent() || session->eisCookie()) {
+            return fail(QDBusError::AccessDenied, QStringLiteral("Local takeover requires a newly approved portal session"));
+        }
+        if (!bus.connect(kwinService(), kwinRemoteDesktopPath(), kwinRemoteDesktopInterface(), QStringLiteral("LocalTakeover"), session, SLOT(localTakeover(int)))) {
+            return fail(QDBusError::Failed, QStringLiteral("Unable to monitor the KWin session"));
+        }
+    }
+
+    const auto method = localTakeover ? QStringLiteral("connectToEISWithLocalTakeover") : QStringLiteral("connectToEIS");
+    auto msg = QDBusMessage::createMethodCall(kwinService(), kwinRemoteDesktopPath(), kwinRemoteDesktopInterface(), method);
     msg.setArguments({static_cast<int>(session->deviceTypes())});
