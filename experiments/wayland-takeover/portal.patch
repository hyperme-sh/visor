+@dbus.service.method(MAIN_IFACE, in_signature="osa{sv}", out_signature="h")
+def ConnectToEISWithLocalTakeover(self, session_handle, app_id, options):
+    if not self.remotedesktop_params.supports_local_takeover:
+        raise dbus.exceptions.DBusException(
+            "Unsupported local takeover",
+            name="org.freedesktop.DBus.Error.UnknownMethod",
+        )
+
+    assert session_handle in self.sessions
+    sockets = socket.socketpair()
+    self.eis_socket = sockets[0]
+    assert self.eis_socket.send(b"LOCAL") == 5
+    with sockets[1]:
+        return dbus.types.UnixFd(sockets[1])
+
+
+@dbus.service.method(MOCK_IFACE, in_signature="o", out_signature="")
+def SimulateLocalTakeover(self, session_handle):
+    self.sessions[session_handle].close()
+
