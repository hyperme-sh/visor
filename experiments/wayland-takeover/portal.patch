+        ConnectToEISWithLocalTakeover:
+        @session_handle: Object path for the RemoteDesktop session
+        @options: Vardict with optional further information
+        @fd: File descriptor for a libei sender
+
+        Prototype opt-in for a fresh, locally approved RemoteDesktop session
+        on a native seat. The compositor stops this EIS sender and closes the
+        session on local pointer motion, a button press, or a key press. The
+        portal returns an error if the selected backend cannot guarantee this.
+        The client must handle EIS disconnect and Session.Closed. Other
+        requirements of ConnectToEIS apply, including one connection per
+        started session and exclusive use of EIS after connecting.
+
+        This method was added in version 3 of this interface.
+    -->
+    <method name="ConnectToEISWithLocalTakeover">
+      <annotation name="org.gtk.GDBus.C.Name" value="connect_to_eis_with_local_takeover"/>
+      <annotation name="org.gtk.GDBus.C.UnixFD" value="true"/>
+      <arg type="o" name="session_handle" direction="in"/>
+      <arg type="a{sv}" name="options" direction="in"/>
+      <arg type="h" name="fd" direction="out"/>
+    </method>
