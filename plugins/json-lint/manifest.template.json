{
  "manifest_version": 1,
  "id": "sh.hyperme.json-lint",
  "package_version": "0.1.0",
  "api_versions": [
    1
  ],
  "profile": "local-stdio",
  "executable_sha256": "",
  "tools": [
    {
      "name": "lint-json",
      "scope": "workspace.read",
      "input_schema": {
        "type": "object",
        "properties": {
          "content_base64": {
            "type": "string"
          }
        },
        "required": [
          "content_base64"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "diagnostics": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32769
                },
                "column": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32769
                },
                "rule": {
                  "enum": [
                    "json-syntax",
                    "json-encoding",
                    "duplicate-key"
                  ]
                }
              },
              "required": [
                "line",
                "column",
                "rule"
              ],
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "diagnostics",
          "truncated"
        ],
        "additionalProperties": false
      }
    }
  ]
}
