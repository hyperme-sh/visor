{
  "manifest_version": 1,
  "id": "org.example.byte-count",
  "package_version": "0.1.0",
  "api_versions": [1, 0],
  "profile": "local-stdio",
  "executable_sha256": "",
  "tools": [{
    "name": "count-bytes",
    "scope": "workspace.read",
    "input_schema": {
      "type": "object",
      "properties": {"content_base64": {"type": "string"}},
      "required": ["content_base64"],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {"byte_count": {"type": "integer", "minimum": 0}},
      "required": ["byte_count"],
      "additionalProperties": false
    }
  }]
}
